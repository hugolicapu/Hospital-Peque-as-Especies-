# ==============================================================================
# Configuración del Sistema de Citas — Hospital de Pequeñas Especies UNAM FESC
# Copia este archivo como ".env" para desarrollo local, o define estas variables
# directamente en el panel de tu proveedor en la nube (Railway, Render, VPS).
# NUNCA subas el archivo ".env" real a Git.
# ==============================================================================

# Interfaz y puerto de escucha (en la nube usa 0.0.0.0 y el PORT asignado)
HOST=0.0.0.0
PORT=3000

# Entorno de ejecución: "development" (local) o "production" (internet con HTTPS)
NODE_ENV=development

# Zona horaria oficial del hospital (evita desfases en servidores UTC)
HOSPITAL_TIMEZONE=America/Mexico_City

# Secreto criptográfico para firmar cookies de sesión (mínimo 32 caracteres aleatorios).
# OBLIGATORIO en producción.
SESSION_SECRET=cambia-este-secreto-por-una-cadena-aleatoria-de-64-caracteres

# Tiempo máximo de inactividad de la sesión del administrador (en minutos)
ADMIN_SESSION_TIMEOUT_MINUTES=15

# Ruta privada del panel de administrador.
# En producción cámbiala a una ruta secreta (ej. /control-fesc-9x7k); /admin devolverá 404.
ADMIN_PATH=/admin

# (Opcional) Lista de IPs separadas por coma autorizadas para abrir el panel admin.
# Déjalo vacío para poder acceder desde tu celular o cualquier conexión HTTPS.
# Ejemplo: ADMIN_ALLOWED_IPS=187.210.45.12,127.0.0.1
ADMIN_ALLOWED_IPS=

# Modo de la aplicación: "all" (ambas páginas), "public" (solo citas) o "admin" (solo panel)
APP_MODE=all

# Activar en "true" cuando la app corre detrás de HTTPS/Proxy (Railway, Render, Nginx, Caddy)
TRUST_PROXY=false

# Motor de base de datos: "mysql" (XAMPP / MySQL en la nube) o "sqlite"
DB_CLIENT=mysql

# Opción A (Nube): URL completa de conexión MySQL (ej. Railway, Aiven, TiDB)
# MYSQL_URL=mysql://usuario:contrasena@host:3306/hospital_fesc_citas

# Opción B (Local XAMPP o parámetros separados):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hospital_fesc_citas

# Activar "true" si tu base de datos MySQL en la nube exige conexión cifrada SSL/TLS
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Ruta local de SQLite (solo se usa si DB_CLIENT=sqlite)
DB_PATH=./data/hospital_fesc.db

# (Opcional — solo primer arranque en la nube sin terminal interactiva)
# Si la tabla admin_account está vacía, crea al único administrador y luego
# debes eliminar estas dos variables del panel de tu proveedor.
# ADMIN_USERNAME=admin_fesc
# ADMIN_PASSWORD=TuPasswordMuyFuerte#2026!
