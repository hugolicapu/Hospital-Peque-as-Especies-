# ==============================================================================
# Configuración del Sistema de Citas — Hospital de Pequeñas Especies UNAM FESC
# Copia este archivo como ".env" y ajusta los valores si lo requieres.
# NUNCA subas el archivo ".env" real a Git.
# ==============================================================================

# Puerto donde escuchará el servidor web local
PORT=3000

# Entorno de ejecución: "development" o "production"
NODE_ENV=development

# Secreto criptográfico para firmar las cookies de sesión (mínimo 32 caracteres).
SESSION_SECRET=cambia-este-secreto-por-una-cadena-aleatoria-de-64-caracteres

# Tiempo máximo de inactividad de la sesión del administrador (en minutos)
ADMIN_SESSION_TIMEOUT_MINUTES=15

# Motor de base de datos: "mysql" (XAMPP / MariaDB por defecto) o "sqlite"
DB_CLIENT=mysql

# Credenciales de conexión MySQL / MariaDB (valores por defecto de XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hospital_fesc_citas

# Ruta de SQLite (solo se usa si DB_CLIENT=sqlite)
DB_PATH=./data/hospital_fesc.db

# Si el servidor está detrás de un proxy inverso HTTPS (Nginx, Caddy, etc.), usa "true"
TRUST_PROXY=false
